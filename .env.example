# =============================================================================
# KisanCred / AgriTrust — Environment Configuration
# =============================================================================

ENVIRONMENT=development
PROJECT_NAME="KisanCred / AgriTrust"
VERSION=0.1.0

# -----------------------------------------------------------------------------
# Database (PostgreSQL + PostGIS)
# -----------------------------------------------------------------------------
POSTGRES_USER=kisancred
POSTGRES_PASSWORD=agritrust_secret
POSTGRES_DB=kisancred_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://kisancred:agritrust_secret@localhost:5432/kisancred_db
SYNC_DATABASE_URL=postgresql://kisancred:agritrust_secret@localhost:5432/kisancred_db

# -----------------------------------------------------------------------------
# Message Queue & Cache (Redis)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Security & JWT Authentication
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=super_secret_jwt_key_for_kisancred_platform_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# Stage 5 Consent Architecture
# -----------------------------------------------------------------------------
CONSENT_SECRET_KEY=consent_master_secret_hmac_key_2026
CONSENT_DEFAULT_TTL_DAYS=30

# -----------------------------------------------------------------------------
# ML Engine & Tracking
# -----------------------------------------------------------------------------
MLFLOW_TRACKING_URI=http://localhost:5000
MODEL_ARTIFACTS_PATH=./ml-engine/models/artifacts

# -----------------------------------------------------------------------------
# Client CORS Origins
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:5173,http://localhost:5174,http://localhost:5175

# -----------------------------------------------------------------------------
# Frontend runtime and shared API origin
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_FARMER_PORT=3000
VITE_FPO_PORT=3001
VITE_LENDER_PORT=3002
